.md#idea06"><mxGeometry as="geometry" x="12" y="30.0" width="247" height="27.5" /></mxCell><mxCell id="n66" parent="n61" vertex="1" value="用途：据此计算检索的四项指标。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=20;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="12" y="66.70000000000005" width="305" height="25.0" /></mxCell><mxCell id="n67" parent="n61" vertex="1" value="本批所有题卡对" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=18;fontColor=#475569;fontStyle=0;"><mxGeometry as="geometry" x="12" y="102.70000000000005" width="131" height="22.5" /></mxCell><mxCell id="s6" parent="n23" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="16" y="812" width="416" height="322" /></mxCell><mxCell id="n69" parent="s6" vertex="1" value="标签把检索、选择和实现三个问题分" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=24;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="16" y="7.0" width="389" height="30.0" /></mxCell><mxCell id="n70" parent="s6" vertex="1" value="清" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=24;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="16" y="39.40000000000009" width="29" height="30.0" /></mxCell><mxCell id="n71" parent="s6" vertex="1" value="适用但未召回是检索漏失；已召回未选是选" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=20;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="16" y="87.79999999999995" width="385" height="25.0" /></mxCell><mxCell id="n72" parent="s6" vertex="1" value="择漏失。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=20;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="16" y="114.79999999999995" width="85" height="25.0" /></mxCell><mxCell id="n73" parent=