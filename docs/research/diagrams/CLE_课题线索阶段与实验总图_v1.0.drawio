n615" vertex="1" value="已结束" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=17;fontColor=#64748b;fontStyle=1;"><mxGeometry as="geometry" x="10" y="1.0" width="56" height="21.25" /></mxCell><mxCell id="n617" parent="D02" vertex="1" value="旧模型反向卡库交叉" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=23;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="14" y="32.0" width="212" height="28.75" /></mxCell><mxCell id="n618" parent="D02" vertex="1" value="v3.2不可用；不替换模型" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=18;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="14" y="85.0" width="205.16" height="22.5" /></mxCell><mxCell id="n619" parent="D02" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="14" y="132" width="49.03" height="25" /></mxCell><mxCell id="n620" parent="n619" vertex="1" value="API" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=17;fontColor=#1d4ed8;fontStyle=1;"><mxGeometry as="geometry" x="10" y="1.0" width="32.03" height="21.25" /></mxCell><mxCell id="n621" parent="D02" vertex="1" value="前置：C09" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=16;fontColor=#64748b;fontStyle=0;"><mxGeometry as="geometry" x="14" y="158.0" width="78.44" height="20.0" /></mxCell><mxCell id="n622" parent="D02" vertex="1" value="CROSS" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=17;fontColor=#475569;fontStyle=1;"><mxGeometry as="geometry" x="70" y="8.0" width="50.05" height="21.25" /></mxCell><mxCell id="n623" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#cbd5e1;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="34.0" y="3134" width="1191.3333333333333" height="166" /></mxCell><mxCell id="n624" parent="n623" vertex="1" value="G1｜从探针进入正式执行" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=28;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="11.0" width="314.68" height="35.0" /></mxCell><mxCell id="n625" parent="n623" vertex="1" value="离线链路、契约、对照与预算就绪。技术探针验证流程；主要全量问题不因几道题的低分取消。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=24;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="20.0" y="58.0" width="1013" height="30.0" /></mxCell><mxCell id="n626" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#cbd5e1;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="1243.3333333333333" y="3134" width="1191.3333333333333" height="166" /></mxCell><mxCell id="n627" parent="n626" vertex="1" value="G2｜何时扩大抽样？" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=28;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="11.0" width="258.68" height="35.0" /></mxCell><mxCell id="n628" parent="n626" vertex="1" value="记忆：有多档差异但工程标签不足，扩到164题。检索：覆盖或区间不足，扩到114题。只扩大一次。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=24;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="20.0" y="58.0" width="1065.32" height="30.0" /></mxCell><mxCell id="n629" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=#cbd5e1;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="2452.6666666666665" y="3134" width="1191.3333333333333" height="166" /></mxCell><mxCell id="n630" parent="n629" vertex="1" value="G3｜何时算阶段完成？" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=28;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="11.0" width="286.68" height="35.0" /></mxCell><mxCell id="n631" parent="n629" vertex="1" value="补齐固定名单和独立重复，做原生回放、配对统计与代码复盘，再接下一项。未执行不记失败。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=24;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="20.0" y="58.0" width="1013" height="30.0" /></mxCell><mxCell id="n632" parent="n0" vertex="1" value="读图：点击实验编号进入对应清单；鼠标停在卡片上可查看目的、当前证据与下一条件。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=24;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="34" y="3320.0" width="941" height="30.0" /></mxCell><mxCell id="n633" parent="n0" vertex="1" value="C04E与C07E是条件扩展，不计作新增核心研究。旧模型历史结果与新模型成绩分别保留。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=23;fontColor=#475569;fontStyle=0;"><mxGeometry as="geometry" x="34" y="3361.0" width="907.52" height="28.75" /></mxCell><mxCell id="n634" parent="n0" vertex="1" value="完整状态与推进条件 → CLE_实验状态与阶段说明清单_v1.0.svg" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=23;fontColor=#1d4ed8;fontStyle=0;" link="CLE_实验状态与阶段说明清单_v1.0.svg"><mxGeometry as="geometry" x="34" y="3403.0" width="670.85" height="28.75" /></mxCell><mxCell id="edge0" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#94a3b8;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="396" y="328" /><mxPoint as="targetPoint" x="410" y="328" /></mxGeometry></mxCell><mxCell id="edge1" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#94a3b8;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="846" y="328" /><mxPoint as="targetPoint" x="860" y="328" /></mxGeometry></mxCell><mxCell id="edge2" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#94a3b8;dashed=0;"><mxGeometry as="geometry" relative="1">