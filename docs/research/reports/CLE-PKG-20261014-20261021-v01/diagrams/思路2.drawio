<mxfile host="drawio" version="26.0.0"><diagram id="cle-research" name="让更多卡获得反馈，做题是否改善？"><mxGraphModel page="1" pageScale="1" pageWidth="1500" pageHeight="650" grid="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n0" parent="1" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="0" y="0" width="1500" height="650" /></mxCell><mxCell id="n1" parent="n0" vertex="1" value="让更多卡获得反馈，做题是否改善？" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=34;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="30" y="13.0" width="549" height="42.5" /></mxCell><mxCell id="n2" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf3f7;strokeColor=#b8c9d6;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="30" y="76" width="1440" height="92" /></mxCell><mxCell id="n3" parent="n2" vertex="1" value="当前判断：更多卡获得了反馈，但覆盖增加没有自动转化为更好的同题成绩。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=28;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="20" y="9.0" width="957" height="35.0" /></mxCell><mxCell id="n4" parent="n2" vertex="1" value="证据判断：覆盖扩大得到支持；覆盖等于收益不成立" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=22;fontColor=#415467;fontStyle=0;"><mxGeometry as="geometry" x="20" y="49.0" width="511" height="27.5" /></mxCell><mxCell id="box0" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#becbd6;dashed=0;container=1;collapsible=0;" link="../10月14日-10月21日实验探索报告.md#r2"><mxGeometry as="geometry" x="30" y="216" width="330" height="265" /></mxCell><mxCell id="n6" parent="box0" vertex="1" value="研究问题" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=27;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="18" y="10.0" width="113" height="33.75" /></mxCell><mxCell id="n7" parent="box0" vertex="1" value="反馈不足是否限制评分作" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=26;fontColor=#0f172a;fontStyle=0;"><mxGeometry as="geometry" x="18" y="57.0" width="291" height="32.5" /></mxCell><mxCell id="n8" parent="box0" vertex="1" value="用？扩大来源题和使用机" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=26;fontColor=#0f172a;fontStyle=0;"><mxGeometry as="geometry" x="18" y="92.10000000000002" width="291" height="32.5" /></mxCell><mxCell id="n9" parent="box0" vertex="1" value="会后会怎样？" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=26;fontColor=#0f172a;fontStyle=0;"><mxGeometry as="geometry" x="18" y="127.19999999999999" width="161" height="32.5" /></mxCell><mxCell id="box1" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#becbd6;dashed=0;container=1;collapsible=0;" link="../10月14日-10月21日实验探索报告.md#a1"><mxGeometry as="geometry" x="400" y="216" width="330" height="265" /></mxCell><mxCell id="n11" parent="box1" vertex="1" value="验证路径" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=27;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="18" y="10.0" width="113" height="33.75" /></mxCell><mxCell id="n12" parent="box1" vertex="1" value="对比不同历史学习配置，" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=26;fontColor=#0f172a;fontStyle=0;"><mxGeometry as="geometry" x="18" y="57.0" width="291" height="32.5" /></mxCell><mxCell id="n13" parent="box1" vertex="1" value="记录有反馈的卡数，再看" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=26;fontColor=#0f172a;fontStyle=0;"><mxGeometry as="geometry" x="18" y="92.10000000000002" width="291" height="32.5" /></mxCell><mxCell id="n14" parent="box1" vertex="1" value="冻结同题回测。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=26;fontColor=#0f172a;fontStyle=0;"><mxGeometry as="geometry" x="18" y="127.19999999999999" width="187" height="32.5" /></mxCell><mxCell id="box2" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#becbd6;dashed=0;container=1;collapsible=0;" link="../10月14日-10月21日实验探索报告.md#a1"><mxGeometry as="geometry" x="770" y="216" width="330" height="265" /></mxCell><mxCell id="n16" parent="box2" vertex="1" value="主要证据" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=27;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="18" y="10.0" width="113" height="33.75" /></mxCell><mxCell id="n17" parent="box2" vertex="1" value="有反馈卡466→972张。同" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=26;fontColor=#0f172a;fontStyle=0;"><mxGeometry as="geometry" x="18" y="57.0" width="295.68" height="32.5" /></mxCell><mxCell id="n18" parent="box2" vertex="1" value="题回测109→100题通过；" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=26;fontColor=#0f172a;fontStyle=0;"><mxGeometry as="geometry" x="18" y="92.10000000000002" width="295.68" height="32.5" /></mxCell><mxCell id="n19" parent="box2" vertex="1" value="两阶段选择方式不同。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=26;fontColor=#0f172a;fontStyle=0;"><mxGeometry as="geometry" x="18" y="127.19999999999999" width="265" height="32.5" /></mxCell><mxCell id="box3" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#becbd6;dashed=0;container=1;collapsible=0;" link="../10月14日-10月21日实验探索报告.md#t1"><mxGeometry as="geometry" x="1140" y="216" width="330" height="265" /></mxCell><mxCell id="n21" parent="box3" vertex="1" value="期末安排" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=27;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="18" y="10.0" width="113" height="33.75" /></mxCell><mxCell id="n22" parent="box3" vertex="1" value="在线增长集完成23/273" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=26;fontColor=#0f172a;fontStyle=0;"><mxGeometry as="geometry" x="18" y="57.0" width="269.68" height="32.5" /></mxCell><mxCell id="n23" parent="box3" vertex="1" value="题；保留剩余250题，再" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=26;fontColor=#0f172a;fontStyle=0;"><mxGeometry as="geometry" x="18" y="92.10000000000002" width="280.34000000000003" height="32.5" /></mxCell><mxCell id="n24" parent="box3" vertex="1" value="冻结并评价。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=26;fontColor=#0f172a;fontStyle=0;"><mxGeometry as="geometry" x="18" y="127.19999999999999" width="161" height="32.5" /></mxCell><mxCell id="n25" parent="n0" vertex="1" value="图示范围：首周历史材料；期末安排截至10月21日22:26。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=21;fontColor=#526071;fontStyle=0;"><mxGeometry as="geometry" x="30" y="510.0" width="546.17" height="26.25" /></mxCell><mxCell id="n26" parent="n0" vertex="1" value="执行：历史学习与同题回测已完成；在线增长学习期末暂停。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=21;fontColor=#526071;fontStyle=0;"><mxGeometry as="geometry" x="30" y="549.0" width="572" height="26.25" /></mxCell><mxCell id="n27" parent="n0" vertex="1" value="【A1 覆盖与回测】" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=23;fontColor=#255c87;fontStyle=0;" link="../10月14日-10月21日实验探索报告.md#a1"><mxGeometry as="geometry" x="30" y="595.0" width="202.57" height="28.75" /></mxCell><mxCell id="n28" parent="n0" vertex="1" value="【A6 期末状态】" style="text;html=1;align=left;verticalAlign=middle;spacing=0