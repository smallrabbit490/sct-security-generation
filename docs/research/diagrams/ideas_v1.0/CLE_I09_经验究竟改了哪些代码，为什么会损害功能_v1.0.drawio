" x="10" y="1.0" width="73" height="21.25" /></mxCell><mxCell id="n15" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="600" y="108" width="73" height="25" /></mxCell><mxCell id="n16" parent="n15" vertex="1" value="已结束" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=17;fontColor=#64748b;fontStyle=1;"><mxGeometry as="geometry" x="10" y="1.0" width="56" height="21.25" /></mxCell><mxCell id="n17" parent="n0" vertex="1" value="箭头表示本想法的验证路径；真正运行前置保留在实验详情。点击彩色实验行查看证据与前置。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=18;fontColor=#475569;fontStyle=0;"><mxGeometry as="geometry" x="44" y="146.0" width="761" height="22.5" /></mxCell><mxCell id="I09-source" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#0f766e;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="306.0" y="218" width="760" height="187" /></mxCell><mxCell id="n19" parent="I09-source" vertex="1" value="S0 提出问题" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=18;fontColor=#475569;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="11.0" width="105.62" height="22.5" /></mxCell><mxCell id="n20" parent="I09-source" vertex="1" value="来源：10月22日汇报材料／用户提供截图" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=23;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="44.0" width="421.76" height="28.75" /></mxCell><mxCell id="n21" parent="I09-source" vertex="1" value="要求要点：区分有用的安全检查与重建对象、替换参数、复制来源假设等改动。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=20;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="20.0" y="88.05000000000001" width="705" height="25.0" /></mxCell><mxCell id="n22" parent="I09-source" vertex="1" value="材料没有单独标明想法提出者；足迹分析方法属于本项目细化，不署为老师原话。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=20;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="20.0" y="127.05000000000001" width="725" height="25.0" /></mxCell><mxCell id="footprint-define" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="381.0" y="505" width="610" height="269" /></mxCell><mxCell id="n24" parent="footprint-define" vertex="1" value="S1 定义观察对象" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=18;fontColor=#475569;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="11.0" width="141.62" height="22.5" /></mxCell><mxCell id="n25" parent="footprint-define" vertex="1" value="记忆足迹：查看有卡与无卡的代码差异" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=23;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="44.0" width="396" height="28.75" /></mxCell><mxCell id="n26" parent="footprint-define" vertex="1" value="截图同时出现模板检查、重定义Person、替换person。它是说明" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=20;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="20.0" y="88.04999999999995" width="572.2" height="25.0" /></mxCell><mxCell id="n27" parent="footprint-define" vertex="1" value="性例子，不冒充实际损失题。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=20;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="20.0" y="115.04999999999995" width="265" height="25.0" /></mxCell><mxCell id="n28" parent="footprint-define" vertex="1" value="汇报中的AST足迹是结构改动指标；改动量不是因果原因，仍须" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=20;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="20.0" y="154.04999999999995" width="556.8" height="25.0" /></mxCell><mxCell id="n29" parent="footprint-define" vertex="1" value="读具体代码。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=20;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="20.0" y="181.04999999999995" width="125" height="25.0" /></mxCell><mxCell id="n30" parent="footprint-define" vertex="1" value="打开依据／对应步骤 ↗" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=18;fontColor=#2563eb;fontStyle=0;" link="https://app.notion.com/p/2026-10-22-3fcc97140eca80e39773c961ea806824"><mxGeometry as="geometry" x="20.0" y="236.0" width="194.54" height="22.5" /></mxCell><mxCell id="footprint-cases" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="44.0" y="874" width="610" height="362" /></mxCell><mxCell id="n32" parent="footprint-cases" vertex="1" value="S6 逐题复盘" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=18;fontColor=#475569;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="11.0" width="105.62" height="22.5" /></mxCell><mxCell id="n33" parent="footprint-cases" vertex="1" value="已做：从实际损失题读原因" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=23;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="44.0" width="281" height="28.75" /></mxCell><mxCell id="n34" parent="footprint-cases" vertex="1" value="先查题面要求，再查经验、计划、代码及验证错误。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=20;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="20.0" y="88.04999999999995" width="465" height="25.0" /></mxCell><mxCell id="n35" parent="footprint-cases" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=none;dashed=0;container=1;collapsible=0;" link=".