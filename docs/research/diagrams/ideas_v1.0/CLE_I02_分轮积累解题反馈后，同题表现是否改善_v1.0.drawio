x="10" y="1.0" width="73" height="21.25" /></mxCell><mxCell id="n15" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="600" y="108" width="73" height="25" /></mxCell><mxCell id="n16" parent="n15" vertex="1" value="已结束" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=17;fontColor=#64748b;fontStyle=1;"><mxGeometry as="geometry" x="10" y="1.0" width="56" height="21.25" /></mxCell><mxCell id="n17" parent="n0" vertex="1" value="箭头表示本想法的验证路径；真正运行前置保留在实验详情。点击彩色实验行查看证据与前置。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=18;fontColor=#475569;fontStyle=0;"><mxGeometry as="geometry" x="44" y="146.0" width="761" height="22.5" /></mxCell><mxCell id="I02-source" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#0f766e;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="306.0" y="218" width="760" height="148" /></mxCell><mxCell id="n19" parent="I02-source" vertex="1" value="S0 提出问题" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=18;fontColor=#475569;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="11.0" width="105.62" height="22.5" /></mxCell><mxCell id="n20" parent="I02-source" vertex="1" value="来源：学长（经用户转述）" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=23;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="44.0" width="281" height="28.75" /></mxCell><mxCell id="n21" parent="I02-source" vertex="1" value="要求要点：在D_grow分轮做题、获取报错反馈，再在这些题上选卡测Joint。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=20;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="20.0" y="88.05000000000001" width="681.5999999999999" height="25.0" /></mxCell><mxCell id="round-plan" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="381.0" y="466" width="610" height="175" /></mxCell><mxCell id="n23" parent="round-plan" vertex="1" value="S1 区分两种积累" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=18;fontColor=#475569;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="11.0" width="141.62" height="22.5" /></mxCell><mxCell id="n24" parent="round-plan" vertex="1" value="把“学Q”与“新建经验”分开" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=23;fontColor=#0f172a;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="44.0" width="316.19" height="28.75" /></mxCell><mxCell id="n25" parent="round-plan" vertex="1" value="左支固定卡片只更新Q；右支从解题过程生成、演化卡片。两条" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=20;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="20.0" y="88.04999999999995" width="555.6" height="25.0" /></mxCell><mxCell id="n26" parent="round-plan" vertex="1" value="支路不能混称同一种学习。" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=20;fontColor=#334155;fontStyle=0;"><mxGeometry as="geometry" x="20.0" y="115.04999999999995" width="245" height="25.0" /></mxCell><mxCell id="round-q" parent="n0" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=0;container=1;collapsible=0;"><mxGeometry as="geometry" x="44.0" y="741" width="610" height="603" /></mxCell><mxCell id="n28" parent="round-q" vertex="1" value="S4 完整Q学习" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=SimSun;fontSize=18;fontColor=#475569;fontStyle=1;"><mxGeometry as="geometry" x="20.0" y="11.0" width="115.16" height="22.5" /></mxCell><mxCell id="n29" parent="round-q" vertex="1" value="固定库：连续三轮积累反馈" style="text;html=1;al